# ==========================================
# Meet Backend (server/)
# ==========================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# ==========================================
# Outbound Email / SMTP (Optional - for real email meeting invitations)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#            SMTP_PASS=<16-char Google App Password>
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Meet <your-email@gmail.com>
ADMIN_ALERT_EMAIL=your-email@gmail.com

# ==========================================
# Razorpay Standard Checkout (Backend only - NEVER expose KEY_SECRET to frontend)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# Supabase (Backend only - NEVER expose SERVICE_ROLE_KEY in frontend)
# ==========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Internal AI Meeting Agent (Gemini Multimodal for Voice + Shared Screen Notes)
# Get a free key from https://aistudio.google.com/apikey
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# LiveKit SFU (Used starting Phase 4)
# ==========================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ==========================================
# Meet Web (apps/web/)
# ==========================================
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# Meet Android (apps/mobile/)
# Note: Use http://10.0.2.2:4000 for Android Emulator, or your PC LAN IP for a physical device
# ==========================================
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
